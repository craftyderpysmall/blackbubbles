# Maintainer: craftyderpysmall
pkgname=blackbubbles-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Messages, Photos, Notes, Calendar, Voice Memos and Find My from your Mac, on Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/craftyderpysmall/blackbubbles"
license=('MIT')
depends=('dbus' 'alsa-lib' 'libxkbcommon' 'wayland' 'libgl')
optdepends=('wl-clipboard: Wayland clipboard for autofill'
            'wtype: click-to-paste codes on wlroots/KDE'
            'ydotool: click-to-paste codes on GNOME'
            'bluez: Find My beacon')
makedepends=('cargo' 'git')
provides=('blackbubbles')
conflicts=('blackbubbles')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd blackbubbles
  printf "0.1.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd blackbubbles
  cargo build --release --locked -p bb-client -p bb-beacon
}

package() {
  cd blackbubbles
  install -Dm755 target/release/blackbubbles "$pkgdir/usr/bin/blackbubbles"
  install -Dm755 target/release/bb-beacon "$pkgdir/usr/bin/bb-beacon"
  install -Dm644 packaging/linux/blackbubbles.desktop "$pkgdir/usr/share/applications/blackbubbles.desktop"
  install -Dm644 packaging/linux/blackbubbles.service "$pkgdir/usr/lib/systemd/user/blackbubbles.service"
  install -Dm644 "packaging/linux/blackbubbles-beacon@.service" "$pkgdir/usr/lib/systemd/system/blackbubbles-beacon@.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
